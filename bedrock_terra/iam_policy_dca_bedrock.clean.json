{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBearerTokenAuth",
      "Effect": "Allow",
      "Action": "bedrock:CallWithBearerToken",
      "Resource": "*"
    },
    {
      "Sid": "MarketplaceViewOnly",
      "Effect": "Allow",
      "Action": "aws-marketplace:ViewSubscriptions",
      "Resource": "*"
    },
    {
      "Sid": "Discovery",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:ListInferenceProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraViaGlobalProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:REDACTED-AWS-ACCOUNT:inference-profile/global.openai.gpt-5.6-terra",
        "arn:aws:bedrock:*::foundation-model/openai.gpt-5.6-terra",
        "arn:aws:bedrock:us-east-1:REDACTED-AWS-ACCOUNT:project/default"
      ]
    },
    {
      "Sid": "Qwen3DirectInRegion",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/qwen.qwen3-next-80b-a3b",
        "arn:aws:bedrock:us-east-1:REDACTED-AWS-ACCOUNT:project/default"
      ]
    }
  ]
}
